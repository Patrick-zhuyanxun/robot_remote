Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.55
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m cells, floor)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 6
      Reference Frame: world
      Color: 160; 160; 164
      Alpha: 0.4
    - Class: rviz_default_plugins/RobotModel
      Name: LEFT arm
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /left/robot_description
      TF Prefix: left
      Alpha: 0.6
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/RobotModel
      Name: RIGHT arm
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /right/robot_description
      TF Prefix: right
      Alpha: 0.6
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/Axes
      Name: world (Isaac rig frame)
      Enabled: true
      Reference Frame: world
      Length: 0.3
      Radius: 0.01
    - Class: rviz_default_plugins/Axes
      Name: left base_link (IK frame)
      Enabled: true
      Reference Frame: left/base_link
      Length: 0.15
      Radius: 0.008
    - Class: rviz_default_plugins/Axes
      Name: right base_link (IK frame)
      Enabled: true
      Reference Frame: right/base_link
      Length: 0.15
      Radius: 0.008
    - Class: rviz_default_plugins/Axes
      Name: left control point (rotates)
      Enabled: true
      Reference Frame: left/control_tcp
      Length: 0.10
      Radius: 0.008
    - Class: rviz_default_plugins/Axes
      Name: right control point (rotates)
      Enabled: true
      Reference Frame: right/control_tcp
      Length: 0.10
      Radius: 0.008
    - Class: rviz_default_plugins/Axes
      Name: left hand translation dirs (never rotate)
      Enabled: true
      Reference Frame: left/hand_axes
      Length: 0.10
      Radius: 0.003
    - Class: rviz_default_plugins/Axes
      Name: right hand translation dirs (never rotate)
      Enabled: true
      Reference Frame: right/hand_axes
      Length: 0.10
      Radius: 0.003
    - Class: rviz_default_plugins/Axes
      Name: left Quest controller (real)
      Enabled: true
      Reference Frame: left/controller
      Length: 0.08
      Radius: 0.006
    - Class: rviz_default_plugins/Axes
      Name: right Quest controller (real)
      Enabled: true
      Reference Frame: right/controller
      Length: 0.08
      Radius: 0.006
    - Class: rviz_default_plugins/Axes
      Name: Quest operator frame (real)
      Enabled: true
      Reference Frame: quest
      Length: 0.2
      Radius: 0.006
    - Class: rviz_default_plugins/MarkerArray
      Name: labels
      Enabled: true
      Topic:
        Value: /teleop_viz/markers
    - Class: rviz_default_plugins/Pose
      Name: left teleop target
      Enabled: true
      Topic:
        Value: /quest_teleop/left/target
      Shape: Axes
      Axes Length: 0.08
      Axes Radius: 0.006
    - Class: rviz_default_plugins/Pose
      Name: right teleop target
      Enabled: true
      Topic:
        Value: /quest_teleop/right/target
      Shape: Axes
      Axes Length: 0.08
      Axes Radius: 0.006
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: world
      Focal Point:
        X: 0.0
        Y: -0.4
        Z: 1.2
      Distance: 2.2
      Yaw: 4.71
      Pitch: 0.45
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1400
  Height: 900
